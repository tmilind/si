---
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
---
<header class="masthead">
  <a class="brand" href="/"><Mark size={28} /><Wordmark /></a>
  <nav aria-label="Primary">
    <a href="/">Stream</a>
    <a href="/about/">About</a>
    <a href="/contact/">Contact</a>
  </nav>
</header>
<style>
  .masthead {
    box-sizing: border-box;
    max-width: 1100px;
    margin: 0 auto;
    height: 84px;
    padding: 0 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand:hover { color: inherit; }
  nav { display: flex; gap: 28px; font-size: 15px; }
  nav a { text-decoration: none; }
  nav a:hover, nav a:focus-visible, .brand:hover, .brand:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--teal);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  @media (max-width: 720px) {
    .masthead { padding: 0 20px; }
    nav { gap: 16px; font-size: 14px; }
  }
  @media (max-width: 480px) {
    .masthead { height: auto; min-height: 84px; flex-wrap: wrap; row-gap: 8px; padding-top: 16px; padding-bottom: 12px; }
  }
</style>
