---
import { marked } from 'marked';
interface Props { md: string }
const { md } = Astro.props;
const html = marked.parse(md, { async: false }) as string;
---
<div class="note-body" set:html={html} />
<style is:global>
  .note-body > :first-child { margin-top: 0; }
  .note-body > :last-child { margin-bottom: 0; }
  .note-body p { margin: 0 0 0.8em; }
  .note-body code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--code-bg);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
  .note-body pre {
    background: var(--code-bg);
    padding: 14px 16px;
    border-radius: 4px;
    overflow-x: auto;
    margin: 0 0 0.8em;
  }
  .note-body pre code { padding: 0; background: none; font-size: 14px; }
</style>
