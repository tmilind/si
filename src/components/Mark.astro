---
interface Props {
  size?: number;
  variant?: 'default' | 'small' | 'dark';
}
const { size = 28, variant = 'default' } = Astro.props;

const dots: [number, number, number][] = [
  [5.5, 5.5, 2.3], [12.5, 5.5, 0.9], [19.5, 5.5, 1.2], [26.5, 5.5, 0.8],
  [5.5, 12.5, 1.1], [12.5, 12.5, 2.3], [19.5, 12.5, 0.9],
  [5.5, 19.5, 0.8], [12.5, 19.5, 1.3], [19.5, 19.5, 2.3], [26.5, 19.5, 1.0],
  [5.5, 26.5, 1.2], [12.5, 26.5, 0.8], [19.5, 26.5, 1.1], [26.5, 26.5, 2.3],
];
// small: map 0.8..2.3 linearly onto 1.2..2.6
const radius = (r: number) =>
  variant === 'small' ? +(1.2 + ((r - 0.8) * (2.6 - 1.2)) / (2.3 - 0.8)).toFixed(3) : r;
const dotFill = variant === 'dark' ? '#DFE3E8' : '#15191D';
const tealFill = variant === 'dark' ? '#33D6C0' : '#0D8A7A';
const tealR = variant === 'small' ? 3.3 : 3.0;
---
<svg viewBox="0 0 32 32" width={size} height={size} xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <g fill={dotFill}>
    {dots.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={radius(r)} />)}
  </g>
  <circle cx="26.5" cy="12.5" r={tealR} fill={tealFill} />
</svg>
