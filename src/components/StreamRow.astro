---
import type { Entry } from '../lib/stream';
import { formatDate } from '../lib/text';
import NoteBody from './NoteBody.astro';
interface Props { entry: Entry }
const { entry } = Astro.props;
---
<article class="row">
  <a class="date" href={entry.url}>{formatDate(entry.date)}</a>
  <div class="main">
    {entry.kind === 'note' ? (
      <>
        <div class="row-body"><NoteBody md={entry.body} /></div>
        {entry.source && <p class="source">On <a href={entry.source.url}>{entry.source.title}</a></p>}
      </>
    ) : (
      <>
        <h2 class="row-title"><a class="plain" href={entry.url}>{entry.title}</a></h2>
        <p class="row-summary">{entry.summary}</p>
        <p class="reading">Long read, {entry.minutes} minutes</p>
      </>
    )}
  </div>
</article>
