---
// About opens with this same sentence, so the footer leaves it out there.
const showLine = Astro.url.pathname !== '/about/';
---
<footer class="footer">
  <div class="footer-inner">
  {showLine && <p class="line">SourceIntellect is a company focused on where AI is going.</p>}
  <nav aria-label="Footer">
    <a href="/">Stream</a>
    <a href="/about/">About</a>
    <a href="/contact/">Contact</a>
    <a href="mailto:hello@sourceintellect.com">hello@sourceintellect.com</a>
  </nav>
  </div>
</footer>
<style>
  .footer {
    box-sizing: border-box;
    max-width: 1100px;
    margin: 64px auto 0;
    padding: 0 72px;
    font-size: 15px;
  }
  /* The rule sits on the inner box so it aligns with the content edge, not the padding. */
  .footer-inner { padding: 32px 0 48px; border-top: 1px solid var(--hairline); }
  .line { margin: 0 0 12px; color: var(--muted); }
  nav { display: flex; flex-wrap: wrap; gap: 8px 28px; }
  nav a { text-decoration: none; padding: 6px 0; }
  nav a:hover, nav a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--teal);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  @media (max-width: 720px) {
    .footer { padding: 0 20px; }
    .footer-inner { padding: 32px 0 40px; }
  }
</style>
